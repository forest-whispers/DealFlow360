// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE_OPERATIONS
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
}

enum QuotationRevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepLevel {
  SALES_MANAGER
  FINANCE_OPERATIONS
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NegotiationStatus {
  ACTIVE
  RESOLVED
}

enum NegotiationMessageAuthorType {
  CUSTOMER
  SALES_REP
}

enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum FulfillmentStatus {
  PENDING
  PARTIALLY_ALLOCATED
  ALLOCATED
  IN_PROGRESS
  FULFILLED
}

enum FulfillmentLineStatus {
  PENDING
  PARTIALLY_ALLOCATED
  ALLOCATED
  FULFILLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  users User[]

  products Product[]
  variants ProductVariant[]

  warehouses Warehouse[]

  invoices      Invoice[]
  subscriptions Subscription[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  discountTierRules      DiscountTierRule[]
  discountCategoryRules  DiscountCategoryRule[]
  discountApprovalPolicy DiscountApprovalPolicy?
  quotations             Quotation[]
  fulfillments           Fulfillment[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(SALES_REP)
  isActive     Boolean  @default(true)

  // Customer-specific
  customerTier    CustomerTier?
  customerProfile Json?

  customerQuotations Quotation[] @relation("CustomerQuotations")

  approvalDecisions ApprovalStep[] @relation("ApprovalDecisions")

  negotiationMessages NegotiationMessage[] @relation("NegotiationMessageAuthors")

  changeRequests ChangeRequest[] @relation("ChangeRequestAuthors")

  customerInvoices      Invoice[]      @relation("CustomerInvoices")
  customerSubscriptions Subscription[] @relation("CustomerSubscriptions")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, role, customerTier])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String
  isActive    Boolean     @default(true)
  basePrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  billingType BillingType @default(ONE_TIME)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  variants ProductVariant[]

  inventoryItems   InventoryItem[]
  fulfillmentLines FulfillmentLine[]

  quotationLines QuotationLine[]

  billingInterval BillingInterval?

  invoiceLines      InvoiceLine[]
  subscriptionLines SubscriptionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@index([organizationId, billingType])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  price      Decimal @db.Decimal(12, 2)
  cost       Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)
  attributes Json?

  inventoryItems   InventoryItem[]
  fulfillmentLines FulfillmentLine[]

  quotationLines QuotationLine[]

  invoiceLines      InvoiceLine[]
  subscriptionLines SubscriptionLine[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model DiscountTierRule {
  id                     String       @id @default(cuid())
  customerTier           CustomerTier
  maximumDiscountPercent Decimal      @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, customerTier])
  @@index([organizationId, isActive])
}

model DiscountCategoryRule {
  id                     String  @id @default(cuid())
  category               String
  maximumDiscountPercent Decimal @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId, isActive])
}

model DiscountApprovalPolicy {
  id String @id @default(cuid())

  salesManagerThreshold      Decimal @db.Decimal(5, 2)
  financeOperationsThreshold Decimal @db.Decimal(5, 2)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model QuotationLine {
  id String @id @default(cuid())

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  lineNumber Int

  name     String
  sku      String?
  category String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)

  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  lineSubtotal Decimal @db.Decimal(12, 2)
  lineDiscount Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  margin        Decimal @db.Decimal(12, 2)
  marginPercent Decimal @db.Decimal(7, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([revisionId, lineNumber])
  @@index([revisionId])
  @@index([productId])
  @@index([variantId])
}

model QuotationRevision {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  revisionNumber Int
  status         QuotationRevisionStatus @default(DRAFT)

  orderDiscountPercent Decimal @default(0) @db.Decimal(5, 2)

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  lineDiscountTotal Decimal @default(0) @db.Decimal(12, 2)
  orderDiscount     Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)
  margin            Decimal @default(0) @db.Decimal(12, 2)
  marginPercent     Decimal @default(0) @db.Decimal(7, 2)

  lines QuotationLine[]

  approvalRequests ApprovalRequest[]

  fulfillments Fulfillment[]

  invoices      Invoice[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, revisionNumber])
  @@index([quotationId])
  @@index([quotationId, status])
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String
  status      QuotationStatus @default(DRAFT)

  customerId String
  customer   User   @relation("CustomerQuotations", fields: [customerId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  revisions QuotationRevision[]

  approvalRequests ApprovalRequest[]

  negotiations Negotiation[]

  fulfillments Fulfillment[]

  invoices      Invoice[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, quoteNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model ApprovalStep {
  id String @id @default(cuid())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  level  ApprovalStepLevel
  status ApprovalStepStatus @default(PENDING)

  decidedById String?
  decidedBy   User?   @relation("ApprovalDecisions", fields: [decidedById], references: [id], onDelete: Restrict)

  decidedAt DateTime?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalRequestId])
  @@index([level, status])
  @@index([decidedById])
}

model ApprovalRequest {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  status ApprovalRequestStatus @default(PENDING)

  steps ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([revisionId])
  @@index([status])
}

model NegotiationMessage {
  id String @id @default(cuid())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NegotiationMessageAuthors", fields: [authorId], references: [id], onDelete: Restrict)

  authorType NegotiationMessageAuthorType

  message String

  createdAt DateTime @default(now())

  @@index([negotiationId, createdAt])
  @@index([authorId])
}

model ChangeRequest {
  id String @id @default(cuid())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ChangeRequestAuthors", fields: [requestedById], references: [id], onDelete: Restrict)

  lineNumber Int?

  quantity        Int?
  discountPercent Decimal? @db.Decimal(5, 2)

  orderDiscountPercent Decimal? @db.Decimal(5, 2)

  message String?

  status ChangeRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([negotiationId])
  @@index([negotiationId, status])
  @@index([requestedById])
}

model Negotiation {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  status NegotiationStatus @default(ACTIVE)

  messages       NegotiationMessage[]
  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([quotationId, status])
}

model InventoryItem {
  id String @id @default(cuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  availableQty Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([warehouseId, productId])
  @@index([warehouseId, variantId])
}

model WarehouseAllocation {
  id String @id @default(cuid())

  fulfillmentLineId String
  fulfillmentLine   FulfillmentLine @relation(fields: [fulfillmentLineId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fulfillmentLineId, warehouseId])
  @@index([fulfillmentLineId])
  @@index([warehouseId])
}

model Warehouse {
  id String @id @default(cuid())

  name     String
  code     String
  priority Int             @default(1)
  status   WarehouseStatus @default(ACTIVE)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inventory   InventoryItem[]
  allocations WarehouseAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model FulfillmentLine {
  id String @id @default(cuid())

  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  quotationLineNumber Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  name String
  sku  String?

  requiredQty  Int
  allocatedQty Int @default(0)

  status FulfillmentLineStatus @default(PENDING)

  allocations WarehouseAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fulfillmentId, quotationLineNumber])
  @@index([fulfillmentId])
  @@index([productId])
  @@index([variantId])
}

model Fulfillment {
  id String @id @default(cuid())

  fulfillmentNumber String

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  status FulfillmentStatus @default(PENDING)

  lines FulfillmentLine[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, fulfillmentNumber])
  @@index([quotationId])
  @@index([revisionId])
  @@index([status])
}

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status InvoiceStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  dueDate DateTime?
  paidAt  DateTime?

  lines    InvoiceLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@unique([quotationId, revisionId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([quotationId])
  @@index([revisionId])
  @@index([customerId])
}

model InvoiceLine {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  quotationLineNumber Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  name String
  sku  String?

  quantity Int

  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, quotationLineNumber])
  @@index([invoiceId])
  @@index([productId])
  @@index([variantId])
}

model Subscription {
  id String @id @default(cuid())

  subscriptionNumber String

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerSubscriptions", fields: [customerId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(ACTIVE)

  billingInterval BillingInterval
  recurringAmount Decimal         @db.Decimal(12, 2)

  startDate       DateTime
  nextBillingDate DateTime

  lines SubscriptionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, subscriptionNumber])
  @@unique([quotationId, revisionId, billingInterval])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([quotationId])
  @@index([revisionId])
  @@index([customerId])
  @@index([organizationId, nextBillingDate])
}

model SubscriptionLine {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  quotationLineNumber Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  name String
  sku  String?

  quantity Int

  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, quotationLineNumber])
  @@index([subscriptionId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  paidAt DateTime @default(now())

  reference String? @unique

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
