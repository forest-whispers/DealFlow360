// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE_OPERATIONS
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
}

enum QuotationRevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepLevel {
  SALES_MANAGER
  FINANCE_OPERATIONS
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  users    User[]
  products Product[]
  variants ProductVariant[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  discountTierRules      DiscountTierRule[]
  discountCategoryRules  DiscountCategoryRule[]
  discountApprovalPolicy DiscountApprovalPolicy?
  quotations             Quotation[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(SALES_REP)
  isActive     Boolean  @default(true)

  // Customer-specific
  customerTier    CustomerTier?
  customerProfile Json?

  customerQuotations Quotation[] @relation("CustomerQuotations")

  approvalDecisions ApprovalStep[] @relation("ApprovalDecisions")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, role, customerTier])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String
  isActive    Boolean     @default(true)
  basePrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  billingType BillingType @default(ONE_TIME)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  variants ProductVariant[]

  quotationLines QuotationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@index([organizationId, billingType])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  price      Decimal @db.Decimal(12, 2)
  cost       Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)
  attributes Json?

  quotationLines QuotationLine[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model DiscountTierRule {
  id                     String       @id @default(cuid())
  customerTier           CustomerTier
  maximumDiscountPercent Decimal      @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, customerTier])
  @@index([organizationId, isActive])
}

model DiscountCategoryRule {
  id                     String  @id @default(cuid())
  category               String
  maximumDiscountPercent Decimal @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId, isActive])
}

model DiscountApprovalPolicy {
  id String @id @default(cuid())

  salesManagerThreshold      Decimal @db.Decimal(5, 2)
  financeOperationsThreshold Decimal @db.Decimal(5, 2)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model QuotationLine {
  id String @id @default(cuid())

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  lineNumber Int

  name     String
  sku      String?
  category String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)

  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  lineSubtotal Decimal @db.Decimal(12, 2)
  lineDiscount Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  margin        Decimal @db.Decimal(12, 2)
  marginPercent Decimal @db.Decimal(7, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([revisionId, lineNumber])
  @@index([revisionId])
  @@index([productId])
  @@index([variantId])
}

model QuotationRevision {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  revisionNumber Int
  status         QuotationRevisionStatus @default(DRAFT)

  orderDiscountPercent Decimal @default(0) @db.Decimal(5, 2)

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  lineDiscountTotal Decimal @default(0) @db.Decimal(12, 2)
  orderDiscount     Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)
  margin            Decimal @default(0) @db.Decimal(12, 2)
  marginPercent     Decimal @default(0) @db.Decimal(7, 2)

  lines QuotationLine[]

  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, revisionNumber])
  @@index([quotationId])
  @@index([quotationId, status])
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String
  status      QuotationStatus @default(DRAFT)

  customerId String
  customer   User   @relation("CustomerQuotations", fields: [customerId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  revisions QuotationRevision[]

  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, quoteNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model ApprovalStep {
  id String @id @default(cuid())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  level  ApprovalStepLevel
  status ApprovalStepStatus @default(PENDING)

  decidedById String?
  decidedBy   User?   @relation("ApprovalDecisions", fields: [decidedById], references: [id], onDelete: Restrict)

  decidedAt DateTime?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalRequestId])
  @@index([level, status])
  @@index([decidedById])
}

model ApprovalRequest {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  status ApprovalRequestStatus @default(PENDING)

  steps ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([revisionId])
  @@index([status])
}
