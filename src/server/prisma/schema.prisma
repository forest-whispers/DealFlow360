// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE_OPERATIONS
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum BillingType {
  ONE_TIME
  RECURRING
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  users    User[]
  products Product[]
  variants ProductVariant[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  discountTierRules      DiscountTierRule[]
  discountCategoryRules  DiscountCategoryRule[]
  discountApprovalPolicy DiscountApprovalPolicy?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(SALES_REP)
  isActive     Boolean  @default(true)

  // Customer-specific
  customerTier    CustomerTier?
  customerProfile Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, role, customerTier])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String
  isActive    Boolean     @default(true)
  basePrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  billingType BillingType @default(ONE_TIME)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@index([organizationId, billingType])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  price      Decimal @db.Decimal(12, 2)
  cost       Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)
  attributes Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model DiscountTierRule {
  id                     String       @id @default(cuid())
  customerTier           CustomerTier
  maximumDiscountPercent Decimal      @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, customerTier])
  @@index([organizationId, isActive])
}

model DiscountCategoryRule {
  id                     String  @id @default(cuid())
  category               String
  maximumDiscountPercent Decimal @db.Decimal(5, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId, isActive])
}

model DiscountApprovalPolicy {
  id String @id @default(cuid())

  salesManagerThreshold      Decimal @db.Decimal(5, 2)
  financeOperationsThreshold Decimal @db.Decimal(5, 2)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}
